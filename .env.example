# ==============================================================================
# AKAUNTING / AKUSOFT ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:  cp .env.example .env (or Copy-Item .env.example .env)
# 2. Update database credentials and secret key for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Name of the application displayed across notifications & pages
APP_NAME=Akaunting

# Environment mode: local, staging, production, testing
APP_ENV=local

# Set to true in development for debug trace. MUST BE false IN PRODUCTION!
APP_DEBUG=true

# Public canonical URL of the application
APP_URL=http://localhost

# Default locale (language)
APP_LOCALE=en-GB

# Application Encryption Key (Generate using: php artisan key:generate)
APP_KEY=

# Cipher encryption algorithm
APP_CIPHER=AES-256-CBC

# Logging configuration: single, daily, syslog, errorlog
APP_LOG=single
APP_LOG_LEVEL=debug

# Flag indicating whether Akaunting installation setup wizard has completed
APP_INSTALLED=false

# Scheduled task time (e.g. daily cron run time)
APP_SCHEDULE_TIME="09:00"

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Database Driver: mysql, sqlite, pgsql
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=akaunting_db
DB_USERNAME=akaunting_admin
DB_PASSWORD=akaunting_password
DB_PREFIX=ak_

# ------------------------------------------------------------------------------
# DRIVER CONFIGURATIONS (CACHE, SESSION, QUEUE, BROADCAST)
# ------------------------------------------------------------------------------
# Cache store driver: file, database, redis, memcached
CACHE_DRIVER=file

# Session storage driver: file, cookie, database, redis
SESSION_DRIVER=file

# Queue worker driver: sync, database, redis
QUEUE_DRIVER=database

# Real-time event broadcasting driver: log, pusher, redis, null
BROADCAST_DRIVER=log

# ------------------------------------------------------------------------------
# MAIL / SMTP CONFIGURATION
# ------------------------------------------------------------------------------
# Mail driver: smtp, sendmail, mailgun, mandrill, ses, log
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# REDIS CONFIGURATION (Optional - for advanced caching & queuing)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
